
MONGO_URI="mongodb://localhost:27017/"
MONGO_DB_NAME="DocAI"
MONGO_TLS="false"

MISTRAL_API_KEY=""

OPENAI_API_KEY=""

# LLM provider and model are read from the active MongoDB document in
# LlmProviderConfig, for example: {"provider":"openai","model":"gpt-4.1-mini"}
USE_LITELLM_OPENAI_PROXY="false"
LITELLM_BASE_URL="http://localhost:4000/v1"
LITELLM_API_KEY=""

# MongoDB logging collections
TOKEN_USAGE_LOG_COLLECTION_NAME="TokenUsageLog"
ENTERPRISE_LOG_COLLECTION_NAME="EnterpriseLog"
AI_USAGE_LOG_ENABLED="true"
LOG_ENABLED="true"
LITELLM_LOCAL_MODEL_COST_MAP="True"
# RabbitMQ broker URL. Default assumes local Homebrew install.
# Run the worker in a separate process: python -m app.workers.tender_processing_worker
USING_RABBITMQ="true"
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
RABBITMQ_EXCHANGE="tender.events"
RABBITMQ_QUEUE="tender.processing"
RABBITMQ_ROUTING_KEY="tender.processing.requested"
RABBITMQ_PREFETCH_COUNT="1"
RABBITMQ_HEARTBEAT_SECONDS="60"
RABBITMQ_RECONNECT_INTERVAL_SECONDS="5"
RABBITMQ_CONSUMER_RETRY_SECONDS="5"
RABBITMQ_HEALTHCHECK_INTERVAL_SECONDS="30"
RABBITMQ_HEALTHCHECK_TIMEOUT_SECONDS="10"
RABBITMQ_DEAD_LETTER_EXCHANGE="tender.events.dead"
RABBITMQ_DEAD_LETTER_QUEUE="tender.processing.dead"
RABBITMQ_DEAD_LETTER_ROUTING_KEY="tender.processing.dead"
RABBITMQ_RETRY_EXCHANGE="tender.events.retry"
RABBITMQ_RETRY_QUEUE="tender.processing.retry"
RABBITMQ_RETRY_ROUTING_KEY="tender.processing.retry"
RABBITMQ_RETRY_DELAY_MS="30000"
TENDER_WORKER_LEASE_SECONDS="3600"
TENDER_WORKER_LEASE_HEARTBEAT_SECONDS="300"
EMBEDDING_BATCH_MAX_ITEMS="100"
EMBEDDING_BATCH_MAX_CHARACTERS="200000"
TENDER_WORKER_LOG_LEVEL="INFO"
AI_MODEL_PRICING_USD_PER_1M='{"gpt-5.6-luna":{"input":0.2,"output":1.2},"gpt-4.1":{"input":2.0,"output":8.0},"text-embedding-3-small":{"input":0.02,"output":0.0},"mistral-large-latest":{"input":2.0,"output":6.0}}'

# Used when MongoDB stores relative document paths.
DOCUMENT_BASE_PATH=""
ORCHESTRATION_RUN_COLLECTION="TenderProcessingJobs"

# Document collection names
COMPANYDOCUMENTCOLLECTIONMONGO="CPDocuments"
TENDERDOCUMENTCOLLECTIONMONGO="CPTenderDocuments"
SECTIONDOCUMENTCOLLECTIONMONGO="SectionDocument"
DOCUMENT_UPLOAD_DIRECTORY="app/infrastrature/documents/input_doc"
COMPANYDOCUMENTCOLLECTIONQDRANT="CPDocuments"
TENDERDOCUMENTCOLLECTIONQDRANT="CPTenderDoc"



QDRANT_URL="https://nooi0.aws.cloud.qdrant.io"

QDRANT_API_KEY=""
